#!/usr/bin/env python3
from datetime import datetime

def get_timestamp():
    return datetime.now().isoformat()

def format_bytes(size):
    for unit in ['B', 'KB', 'MB', 'GB']:
        if size < 1024.0:
            return f"{size:.2f} {unit}"
        size /= 1024.0
    return f"{size:.2f} TB"

def safe_json_loads(data):
    try:
        import json
        return json.loads(data)
    except:
        return None